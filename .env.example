# Copy to .env for local development. Never commit .env.
# Every value here is a local-only default; staging and production values come
# from AWS Secrets Manager / Parameter Store (see docs/architecture/deployment.md).

# ---------- API and worker (Go) ----------
MISE_ENV=local
HTTP_ADDR=:8090
LOG_LEVEL=debug
DATABASE_URL=postgres://mise:mise@localhost:5460/mise?sslmode=disable
TEST_DATABASE_URL=postgres://mise:mise@localhost:5460/mise_test?sslmode=disable

# At least 32 bytes. Generate with: openssl rand -base64 48
TOKEN_SIGNING_KEY=local-development-signing-key-not-for-production

# Marketing site origin (used in email links) and browser origins allowed to call the API.
PUBLIC_SITE_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:3100

# Number of proxies in front of the API that append to X-Forwarded-For (ALB = 1).
# Locally it is 1 so the end-to-end tests can sign up from different addresses.
TRUSTED_PROXY_HOPS=1
# Local only (the API refuses to start with this anywhere else): lets the
# end-to-end tests sign up repeatedly.
RATE_LIMITS_DISABLED=true

# Double opt-in. When false, leads join the list without confirming their email.
EMAIL_VERIFICATION_REQUIRED=true
# Comma-separated converted-referral counts that trigger an email, e.g. 3,5,10. Empty = off.
REFERRAL_MILESTONES=
CONSENT_VERSION=2026-09

# smtp sends through SMTP_HOST (Mailpit locally, SES in AWS). log only logs the subject.
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Mise <hello@mise.local>

ADMIN_SESSION_TTL=12h

# ---------- Marketing site (Next.js) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# API origin as seen by the browser.
NEXT_PUBLIC_API_URL=http://localhost:8090

# ---------- Shared by both Next.js apps ----------
# API origin as seen by the Next.js servers (differs from the public URL inside Docker/AWS).
API_INTERNAL_URL=http://localhost:8090

# ---------- End-to-end tests ----------
# The local admin created by `pnpm misectl admin create` in the README.
E2E_ADMIN_EMAIL=admin@mise.local
E2E_ADMIN_PASSWORD=mise-local-admin-2026
MAILPIT_URL=http://localhost:8026

# ---------- Admin app (Next.js) ----------
# Set to false only for local http development.
ADMIN_COOKIE_SECURE=false

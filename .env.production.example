# Production settings for docker-compose.prod.yml.
# Copy to .env.production ON THE SERVER and fill in. Never commit .env.production.

# The site's domain, without https:// (the admin is served at admin.<DOMAIN>).
DOMAIN=example.com

# A database and user created only for Mise on your existing PostgreSQL server.
# Without Docker use 127.0.0.1 as the host. With Docker and PostgreSQL on this same
# server, use host.docker.internal
# (and allow connections from the Docker network in pg_hba.conf / listen_addresses).
DATABASE_URL=postgres://mise:CHANGE_ME@host.docker.internal:5432/mise?sslmode=disable

# Generate once and keep it: openssl rand -base64 48
# Changing it later invalidates every link in emails already sent.
TOKEN_SIGNING_KEY=

LOG_LEVEL=info
CONSENT_VERSION=2026-10

# Double opt-in. Needs working email below; set to false to let people join without confirming.
EMAIL_VERIFICATION_REQUIRED=true
REFERRAL_MILESTONES=

# Outgoing email over SMTP. For Amazon SES: host email-smtp.<region>.amazonaws.com,
# port 587, STARTTLS true, and SES SMTP credentials (not your AWS login).
MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Mise <hello@example.com>

ADMIN_SESSION_TTL=12h
ADMIN_SESSION_IDLE_TTL=2h

# Sprint 1. Admins enrol an authenticator app at their next sign-in (MFA is
# always on in production). Generate each value once and keep it:
#   DATA_ENCRYPTION_KEY: openssl rand -base64 32   (seals MFA secrets; losing it means every admin re-enrols)
#   BFF_SHARED_KEY:      openssl rand -base64 48
DATA_ENCRYPTION_KEY=
BFF_SHARED_KEY=

# Customer accounts stay closed until the business decides to open them.
# Opened for launch (business decision, 11 November 2026).
CUSTOMER_REGISTRATION_ENABLED=true
CUSTOMER_APP_URL=https://app.example.com
TERMS_VERSION=draft-2026-11

# ---------- Meal catalogue (Sprint 2) ----------
# Shows demo meals to customers and allows publishing them. Defaults to true
# locally and false elsewhere. Load demo content with: pnpm misectl catalog seed-demo
CATALOG_DEMO_ENABLED=false
# Extra https hosts meal photographs may come from (comma-separated), besides
# the customer app's /catalog/ folder. Read by the API and the customer app.
CATALOG_IMAGE_HOSTS=

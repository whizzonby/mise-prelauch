# Copy to .env for local development. Never commit .env.
# Every value here is a local-only default; staging and production values come
# from AWS Secrets Manager / Parameter Store (see docs/architecture/deployment.md).

# ---------- API and worker (Go) ----------
MISE_ENV=local
HTTP_ADDR=:8090
LOG_LEVEL=debug
DATABASE_URL=postgres://mise:mise@localhost:5460/mise?sslmode=disable
TEST_DATABASE_URL=postgres://mise:mise@localhost:5460/mise_test?sslmode=disable

# At least 32 bytes. Generate with: openssl rand -base64 48
TOKEN_SIGNING_KEY=local-development-signing-key-not-for-production

# Marketing site origin (used in email links) and browser origins allowed to call the API.
PUBLIC_SITE_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:3100

# Number of proxies in front of the API that append to X-Forwarded-For (ALB = 1).
# Locally it is 1 so the end-to-end tests can sign up from different addresses.
TRUSTED_PROXY_HOPS=1
# Local only (the API refuses to start with this anywhere else): lets the
# end-to-end tests sign up repeatedly.
RATE_LIMITS_DISABLED=true

# Double opt-in. When false, leads join the list without confirming their email.
EMAIL_VERIFICATION_REQUIRED=true
# Comma-separated converted-referral counts that trigger an email, e.g. 3,5,10. Empty = off.
REFERRAL_MILESTONES=
CONSENT_VERSION=2026-09

# smtp sends through SMTP_HOST (Mailpit locally, SES in AWS). log only logs the subject.
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Mise <hello@mise.local>

ADMIN_SESSION_TTL=12h
ADMIN_SESSION_IDLE_TTL=2h
# Staff must use an authenticator app. Defaults to false only when MISE_ENV=local;
# it cannot be false in production. Set true locally to try the MFA screens.
ADMIN_MFA_REQUIRED=false
# Admin console origin, used in staff invitation emails.
ADMIN_APP_URL=http://localhost:3101

# ---------- Customer accounts ----------
# Customer web app origin, used in account emails.
CUSTOMER_APP_URL=http://localhost:3102
# Defaults to true locally and false elsewhere: opening sign-ups is a business decision.
CUSTOMER_REGISTRATION_ENABLED=true
CUSTOMER_SESSION_TTL=720h
CUSTOMER_SESSION_IDLE_TTL=168h
TERMS_VERSION=draft-2026-11

# ---------- Meal catalogue (Sprint 2) ----------
# Shows demo meals to customers and allows publishing them. Defaults to true
# locally and false elsewhere. Load demo content with: pnpm misectl catalog seed-demo
CATALOG_DEMO_ENABLED=true
# Extra https hosts meal photographs may come from (comma-separated), besides
# the customer app's /catalog/ folder. Read by the API and the customer app.
CATALOG_IMAGE_HOSTS=

# ---------- Subscription commerce (Sprint 3) ----------
# Several of these hold business decisions that are still open; the defaults
# charge no tax and no delivery fee. See docs/architecture/SPRINT_3_PLAN.md.
# Weekly selection cutoff (owner's decision: Thursday 23:59, Trinidad and Tobago time).
MENU_CUTOFF_WEEKDAY=thursday
MENU_CUTOFF_TIME=23:59
# Tax: none, inclusive (prices include it) or exclusive (added on top). NOT DECIDED.
BILLING_TAX_MODE=none
# Basis points: 1250 = 12.5%. Only used when BILLING_TAX_MODE is not none.
BILLING_TAX_RATE_BPS=0
BILLING_TAX_LABEL=VAT
# Printed on invoices only when set. Never invent one.
BILLING_TAX_REGISTRATION=
# Per week, in cents. NOT DECIDED: 0 means no delivery fee.
BILLING_DELIVERY_FEE_MINOR=0
BILLING_BUSINESS_NAME=Mise
# Lines separated by \n.
BILLING_BUSINESS_ADDRESS=
# Each week is billed this long before its cutoff (prepaid weekly).
BILLING_RENEWAL_LEAD=48h
# Automatic retries of a failed renewal charge. NOT DECIDED: 0 = none.
BILLING_RENEWAL_RETRIES=0
BILLING_RENEWAL_RETRY_AFTER=24h
SUBSCRIPTION_MAX_PAUSE_WEEKS=4
# A subscription still unpaid after this long is expired.
SUBSCRIPTION_PENDING_TTL=24h
COMMERCE_SCHEDULER_INTERVAL=1m
# The payment simulator (no real money). Default on locally, off elsewhere;
# the API refuses to start with it in production. No real provider exists yet.
PAYMENTS_TEST_PROVIDER=true
# Signs the simulator's webhooks. Empty: derived from TOKEN_SIGNING_KEY.
PAYMENTS_TEST_PROVIDER_SECRET=

# Seals TOTP secrets in the database. 32 bytes, base64: openssl rand -base64 32
# Optional locally (derived from TOKEN_SIGNING_KEY when empty); set it in staging and production.
DATA_ENCRYPTION_KEY=

# Shared by the API and the admin and customer Next.js servers, so the API can
# believe the end user's address they pass on. At least 32 characters.
BFF_SHARED_KEY=local-bff-key-local-bff-key-local-bff

# ---------- Marketing site (Next.js) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# API origin as seen by the browser.
NEXT_PUBLIC_API_URL=http://localhost:8090
# The customer app (meal kits, plans, sign-in, checkout) as seen by the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3102
# waitlist (pre-launch, the default) or launch (calls to action open the meal
# kits and plans). Switching to launch is a go-live decision: see
# docs/launch/GO_LIVE_CHECKLIST.md.
NEXT_PUBLIC_SITE_MODE=waitlist

# ---------- Shared by both Next.js apps ----------
# API origin as seen by the Next.js servers (differs from the public URL inside Docker/AWS).
API_INTERNAL_URL=http://localhost:8090

# ---------- End-to-end tests ----------
# The local admin created by `pnpm misectl admin create` in the README.
E2E_ADMIN_EMAIL=admin@mise.local
E2E_ADMIN_PASSWORD=mise-local-admin-2026
MAILPIT_URL=http://localhost:8026

# ---------- Customer app (Next.js) ----------
# Set to false only for local http development.
WEB_COOKIE_SECURE=false

# ---------- Admin app (Next.js) ----------
# Set to false only for local http development.
ADMIN_COOKIE_SECURE=false

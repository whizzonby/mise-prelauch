# HTTPS front for docker-compose.prod.yml (the "caddy" profile).
# Caddy obtains and renews Let's Encrypt certificates on its own, once DNS for
# both names points at this server.

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy marketing:3100
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

admin.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy admin:3101
}

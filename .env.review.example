# Settings for the owner's review server (docker-compose.review.yml).
# Copy to .env.production ON THE SERVER (the compose files read that name), fill in the CHANGE_ME
# values, then: chmod 600 .env.production
# Never commit .env.production. Steps: docs/launch/REVIEW_SERVER.md

# The domain bought for Mise, without https:// . The site is https://<DOMAIN>; the customer app
# https://app.<DOMAIN>; the admin https://admin.<DOMAIN>; the email inbox https://mail.<DOMAIN>.
DOMAIN=CHANGE_ME.com
# launch: the site shows meal kits and plans and points to the customer app (best for reviewing
# the whole journey). waitlist: the pre-launch site.
SITE_MODE=launch

# Generate each once (commands in docs/launch/REVIEW_SERVER.md) and keep them.
POSTGRES_PASSWORD=CHANGE_ME
TOKEN_SIGNING_KEY=CHANGE_ME
DATA_ENCRYPTION_KEY=CHANGE_ME
BFF_SHARED_KEY=CHANGE_ME

# Login for the email inbox at https://mail.<DOMAIN> (every email the system sends lands there).
MAILPIT_USER=owner
MAILPIT_PASSWORD=CHANGE_ME
MAIL_FROM=Mise <hello@CHANGE_ME.com>

LOG_LEVEL=info
CONSENT_VERSION=2026-10
TERMS_VERSION=draft-2026-11
EMAIL_VERIFICATION_REQUIRED=true
CUSTOMER_REGISTRATION_ENABLED=true

# Staff sign-in without an authenticator app, for an easy review with demo data only.
# Set to true before any real customer data is entered.
ADMIN_MFA_REQUIRED=false
ADMIN_SESSION_TTL=12h
ADMIN_SESSION_IDLE_TTL=2h

# Demo meals and plans (loaded with the seed commands in the guide).
CATALOG_IMAGE_HOSTS=

# Commerce: the open business decisions stay at their safe defaults (no tax, no delivery fee).
MENU_CUTOFF_WEEKDAY=thursday
MENU_CUTOFF_TIME=23:59
BILLING_TAX_MODE=none
BILLING_TAX_RATE_BPS=0
BILLING_TAX_LABEL=VAT
BILLING_TAX_REGISTRATION=
BILLING_DELIVERY_FEE_MINOR=0
BILLING_BUSINESS_NAME=Mise
BILLING_BUSINESS_ADDRESS=
BILLING_RENEWAL_LEAD=48h
BILLING_RENEWAL_RETRIES=0
BILLING_RENEWAL_RETRY_AFTER=24h
SUBSCRIPTION_MAX_PAUSE_WEEKS=4
SUBSCRIPTION_PENDING_TTL=24h
COMMERCE_SCHEDULER_INTERVAL=1m
PAYMENTS_TEST_PROVIDER_SECRET=

# Real payment providers stay empty for the review (see docs/architecture/PAYMENT_ARCHITECTURE.md).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCIES=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCIES=
SCOTIABANK_MERCHANT_ID=

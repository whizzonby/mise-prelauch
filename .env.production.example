# Production settings for docker-compose.prod.yml.
# Copy to .env.production ON THE SERVER and fill in. Never commit .env.production.

# The site's domain, without https:// (the admin is served at admin.<DOMAIN>).
DOMAIN=example.com

# A database and user created only for Mise on your existing PostgreSQL server.
# If PostgreSQL runs on this same server, use host.docker.internal as the host
# (and allow connections from the Docker network in pg_hba.conf / listen_addresses).
DATABASE_URL=postgres://mise:CHANGE_ME@host.docker.internal:5432/mise?sslmode=disable

# Generate once and keep it: openssl rand -base64 48
# Changing it later invalidates every link in emails already sent.
TOKEN_SIGNING_KEY=

LOG_LEVEL=info
CONSENT_VERSION=2026-10

# Double opt-in. Needs working email below; set to false to let people join without confirming.
EMAIL_VERIFICATION_REQUIRED=true
REFERRAL_MILESTONES=

# Outgoing email over SMTP. For Amazon SES: host email-smtp.<region>.amazonaws.com,
# port 587, STARTTLS true, and SES SMTP credentials (not your AWS login).
MAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Mise <hello@example.com>

ADMIN_SESSION_TTL=12h
